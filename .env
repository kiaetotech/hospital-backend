# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5001
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
DB_URI=mongodb://localhost:27017/hospital_db
# For production use:
# DB_URI=mongodb+srv://kiaetotech:Kiaeto2412@cluster0.4vjxrfm.mongodb.net/hospital?retryWrites=true&w=majority&appName=Cluster0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=my_test_secret_12345
JWT_EXPIRY=7d

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_KEY=admin_secret_key_2024
ADMIN_EMAIL=admin@ayurvedawellnesshub.com

# ============================================
# AI SERVICE CONFIGURATION
# ============================================

# Groq AI (Primary - FREE, 30 RPM)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini Flash (Fallback - FREE, 15 RPM)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# SMS PROVIDER CONFIGURATION
# ============================================

# Options: 'msg91', 'gupshup', 'twilio', 'console'
SMS_PROVIDER=console

# MSG91 (Recommended for India - Cheapest)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=KIAETO
MSG91_TEMPLATE_ID=your_template_id
MSG91_FLOW_ID=your_flow_id

# Gupshup (Alternative for India)
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_SENDER_ID=KIAETO
GUPSHUP_USERNAME=your_username
GUPSHUP_PASSWORD=your_password

# Twilio (Global Fallback)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=hospital_documents

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxx

# ============================================
# EMAIL CONFIGURATION (SendGrid)
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=support@ayurvedawellnesshub.com
SENDGRID_FROM_NAME=Ayurveda Wellness Hub

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://hospital-frontend-kiaeto.vercel.app

# ============================================
# PLATFORM SETTINGS
# ============================================
PLATFORM_NAME=Ayurveda Wellness Hub
PLATFORM_EMAIL=support@ayurvedawellnesshub.com
PLATFORM_PHONE=+91-XXXXXXXXXX

# ============================================
# COMMISSION RATES
# ============================================
DOCTOR_FIRST_CONSULT_COMMISSION=15
DOCTOR_REPEAT_CONSULT_COMMISSION=5
PANCHAKARMA_COMMISSION=20
HOME_THERAPY_COMMISSION=15

# ============================================
# AUTO-PAYOUT SCHEDULE
# ============================================
PAYOUT_SCHEDULE_DAY=Monday
PAYOUT_SCHEDULE_TIME=09:00
AUTO_PAYOUT_ENABLED=false

# ============================================
# INSURANCE MODULE CONFIGURATION
# ============================================

# Insurance Commission Rates
INSURANCE_DEFAULT_COMMISSION=15
INSURANCE_AGENT_COMMISSION=5
INSURANCE_CORPORATE_COMMISSION=10

# Insurance Free-Look Period (Days)
INSURANCE_FREE_LOOK_PERIOD=15

# Insurance Grace Period (Days)
INSURANCE_GRACE_PERIOD=30

# Insurance Settlement Terms
INSURANCE_SETTLEMENT_TERMS=weekly

# Insurance Renewal Reminder (Days before expiry)
INSURANCE_RENEWAL_REMINDER_DAYS=30

# ============================================
# OTP CONFIGURATION
# ============================================

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_BLOCK_DURATION_MINUTES=30

# ============================================
# RATE LIMITING
# ============================================

# Rate Limit Settings
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=5
OTP_RATE_LIMIT_MAX_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_MINUTES=1

# ============================================
# INSURANCE CLAIM SETTINGS
# ============================================

# Claim Processing
CLAIM_AUTO_APPROVAL_ENABLED=false
CLAIM_MAX_AMOUNT_AUTO_APPROVE=5000
CLAIM_PROCESSING_DAYS=7

# ============================================
# PDF GENERATION
# ============================================

# Policy Document Settings
POLICY_DOCUMENT_FONT_SIZE=12
POLICY_DOCUMENT_MARGIN_TOP=50
POLICY_DOCUMENT_MARGIN_BOTTOM=50
POLICY_DOCUMENT_MARGIN_LEFT=50
POLICY_DOCUMENT_MARGIN_RIGHT=50

# ============================================
# WEBHOOK SETTINGS
# ============================================

# Razorpay Webhook
RAZORPAY_WEBHOOK_ENABLED=true
RAZORPAY_WEBHOOK_URL=/api/webhooks/razorpay

# ============================================
# INSURANCE COMPANY VERIFICATION
# ============================================

# Required Documents for Insurance Company Verification
INSURANCE_COMPANY_REQUIRED_DOCS=irda_certificate,gst_certificate,pan_card,bank_details

# Auto-verify Insurance Companies (DANGER: Only for testing)
INSURANCE_COMPANY_AUTO_VERIFY=false

# ============================================
# INSURANCE POLICY SETTINGS
# ============================================

# Policy Number Prefix
POLICY_NUMBER_PREFIX=POL

# Max Members in Family Floater
MAX_FAMILY_MEMBERS=6

# Default Sum Insured Options (comma separated)
DEFAULT_SUM_INSURED_OPTIONS=500000,1000000,2500000,5000000,10000000

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/Disable Features
FEATURE_INSURANCE_ENABLED=true
FEATURE_INSURANCE_CLAIMS_ENABLED=true
FEATURE_INSURANCE_CORPORATE_ENABLED=false
FEATURE_INSURANCE_COMPARE_ENABLED=true
FEATURE_INSURANCE_PREMIUM_CALCULATOR_ENABLED=true
FEATURE_INSURANCE_AGENT_DASHBOARD_ENABLED=false

# ============================================
# LOGGING & DEBUG
# ============================================

# Log Levels: error, warn, info, debug, trace
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_SQL_LOGGING=false

# ============================================
# PERFORMANCE
# ============================================

# Caching
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=300

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_MAX=20

# ============================================
# SECURITY
# ============================================

# Security Headers
ENABLE_CORS=true
CORS_ORIGIN=*
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true

# Session
SESSION_SECRET=your_session_secret_here
SESSION_EXPIRY=86400000

# ============================================
# INSURANCE REPORTS
# ============================================

# Report Generation
REPORT_AUTO_GENERATE=true
REPORT_GENERATION_HOUR=2
REPORT_RETENTION_DAYS=365

# ============================================
# INSURANCE NOTIFICATIONS
# ============================================

# Notification Settings
ENABLE_INSURANCE_EMAIL_NOTIFICATIONS=true
ENABLE_INSURANCE_SMS_NOTIFICATIONS=true
ENABLE_INSURANCE_PUSH_NOTIFICATIONS=false

# ============================================
# INSURANCE PAYMENT SETTINGS
# ============================================

# Payment Settings
INSURANCE_PAYMENT_RETRY_MAX=3
INSURANCE_PAYMENT_RETRY_DELAY_SECONDS=300
INSURANCE_PAYMENT_TIMEOUT_SECONDS=1800

# ============================================
# INSURANCE SETTLEMENT (Bank Transfer)
# ============================================

# Settlement Bank Details (Platform's Bank)
SETTLEMENT_BANK_NAME=Your Bank Name
SETTLEMENT_BANK_ACCOUNT_NUMBER=1234567890
SETTLEMENT_BANK_IFSC=IFSC0001234
SETTLEMENT_BANK_ACCOUNT_HOLDER=Platform Name

# ============================================
# INSURANCE PDF TEMPLATES
# ============================================

# Policy PDF Settings
POLICY_PDF_TEMPLATE_DIR=./templates/policies
POLICY_PDF_FONT_FAMILY=Helvetica
POLICY_PDF_COLOR_PRIMARY=#1a56db
POLICY_PDF_COLOR_SECONDARY=#e5e7eb
groq
# ============================================
# MISC
# ============================================

# Default Timezone
TIMEZONE=Asia/Kolkata

# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹

# Date Format
DATE_FORMAT=DD-MM-YYYY
DATETIME_FORMAT=DD-MM-YYYY HH:mm:ss

# ============================================
# REDIS CLOUD CONFIGURATION
# ============================================
REDIS_HOST=moon-tight-brownish-34092.db.redis.io
REDIS_PORT=19889
REDIS_PASSWORD=cCL8pZmJn4mxvj2pKREYZWF4qhjVnmvs
